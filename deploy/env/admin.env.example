# The admin panel, in production. Copy to apps/admin/.env on the VM.
#
# `apps/admin/.env.example` is the development version and explains what every
# variable is for. This one is the production shape: what actually differs on
# the box, and the handful of values that fail silently when they are wrong.
#
# NODE_ENV is set by PM2, not here. With it set, `src/lib/env.ts` refuses to
# start on a secret still reading `change-me` — which is the only one of these
# that announces itself.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Your Postgres. The website never gets this, and there is nowhere in
# apps/web that could use it.
#
# `?schema=public` is not optional noise: Prisma reads the search path from it.
# Add `&sslmode=require` for a managed Postgres that insists on TLS.
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/lotuspeak?schema=public"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# `bash scripts/generate-secrets.sh` from the repo root prints these.
# Generate them ON THE VM, or at least not into a file you will commit.
# Changing either signs everybody out, which is the correct response to a leak.
AUTH_SECRET="GENERATE-ME"
AUTH_REFRESH_SECRET="GENERATE-ME"
AUTH_ACCESS_TTL_MINUTES=15
AUTH_REFRESH_TTL_DAYS=30

# ---------------------------------------------------------------------------
# The website
# ---------------------------------------------------------------------------
# The website's PUBLIC origin, not 127.0.0.1:6010. "View on site" and every
# preview link are built from it, and the office follows them in a browser
# that is not on this box.
#
# Publishing POSTs a revalidation here, so this origin has to be reachable
# from the VM — through whatever terminates TLS, and back in. If the tunnel is
# down, publishing silently stops reaching the site and
# CONTENT_REVALIDATE_SECONDS (an hour) is what eventually carries it.
SITE_URL="https://lotuspeak.org"

# Must equal REVALIDATE_SECRET in apps/web/.env. Two ends of one HMAC: if they
# differ, nothing errors and publishing just stops arriving.
SITE_REVALIDATE_SECRET="GENERATE-ME"

# Must equal PREVIEW_SECRET in apps/web/.env, or every preview link is refused.
PREVIEW_SECRET="GENERATE-ME"

# ---------------------------------------------------------------------------
# Media storage — RustFS
# ---------------------------------------------------------------------------
# RustFS speaks S3, so this is the same driver MinIO runs in development with
# different values. Nothing in the code knows the difference.
STORAGE_DRIVER="s3"

# Where the panel TALKS to the store, over the API. May be an internal address
# — 127.0.0.1 if RustFS is on this VM — because only the panel uses it.
S3_ENDPOINT="http://127.0.0.1:9000"
S3_REGION="us-east-1"

# Your bucket for this client. One bucket per client, so this is the name that
# changes between deployments and the one worth checking twice.
S3_BUCKET="lotuspeak-media"

S3_ACCESS_KEY_ID="RUSTFS-ACCESS-KEY"
S3_SECRET_ACCESS_KEY="RUSTFS-SECRET-KEY"

# RustFS addresses a bucket by path, like MinIO, not by subdomain like AWS.
# With this false the SDK follows a 301 to `bucket.your-host`, which does not
# resolve, and the error reads as a network failure rather than a config one.
S3_FORCE_PATH_STYLE=true

# Where a VISITOR'S BROWSER fetches a photograph. Public, absolute, no
# trailing slash — and not the same value as S3_ENDPOINT unless the store is
# reachable from the internet on that address.
#
# Every image URL on the website is this plus `/media/<id>/<width>.webp`. The
# bucket must allow anonymous read on objects or every photograph on the site
# is broken with nothing in any log saying why:
#     node deploy/media-sync.mjs verify --public-url <this value> …
MEDIA_PUBLIC_URL="https://s3.example.com/lotuspeak-media"

# Read by the `local` driver, which this deployment does not use, and by the
# MCP endpoint, which advertises it to AI clients as where to sign in. Left
# correct either way: a wrong value is a localhost src on every photograph the
# day somebody switches the driver, and a sign-in loop for every AI client now.
ADMIN_PUBLIC_URL="https://panel.lotuspeak.org"

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# No API key on this side, deliberately: the WEBSITE sends an enquiry's two
# messages, so a panel that is down or mid-deploy cannot swallow an enquiry.
# What stays here is the record, the daily count and the delivery notices.

# Must equal MAIL_REPORT_SECRET in apps/web/.env. Unset means mail still goes
# out and the Email screen stays empty for ever.
MAIL_REPORT_SECRET="GENERATE-ME"

# From the webhook's page in the Resend dashboard; begins `whsec_`. Point the
# webhook at https://<this panel>/api/webhooks/resend — which means the panel
# needs to be reachable from the internet at that one path. Without it every
# message stops at "Sent" and a bounce is never recorded.
RESEND_WEBHOOK_SECRET=""

# Resend's free plan allows a hundred a day.
MAIL_DAILY_CAP=100

# ---------------------------------------------------------------------------
# Cloudflare Turnstile — the check in front of the enquiry forms
# ---------------------------------------------------------------------------
# Free, from dash.cloudflare.com → Turnstile → Add widget (the domain does not
# have to be on Cloudflare). List every hostname the forms are served from.
# Both or neither: one without the other stops the panel starting, because a
# secret with no site key would refuse every enquiry. Empty means no check.
# The site key reaches the website through the site settings; nothing to set
# there.
#
# For development, Cloudflare's test pair always passes:
#   TURNSTILE_SITE_KEY="1x00000000000000000000AA"
#   TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ---------------------------------------------------------------------------
# AI clients (MCP) — see docs/AI-MCP.md
# ---------------------------------------------------------------------------
# Empty in production: ADMIN_PUBLIC_URL is already the address a client uses.
MCP_BASE_URL=""
MCP_EXTRA_ORIGINS=""

# ---------------------------------------------------------------------------
# The first owner — read by `npm run db:seed` on an EMPTY database only
# ---------------------------------------------------------------------------
# The seed creates this account when the users table is empty and leaves
# users alone from then on, so editing these later changes nothing: the
# password is changed in the panel, or with `npm run db:seed:owner`.
#
# Single quotes, so a $ or # in the password is taken literally. Clear the
# password once you have signed in; it has no reason to sit beside the
# secrets after the first seed.
SEED_OWNER_EMAIL=''
SEED_OWNER_NAME=''
SEED_OWNER_PASSWORD=''
