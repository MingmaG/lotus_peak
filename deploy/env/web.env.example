# The website, in production. Copy to apps/web/.env on the VM.
#
# `apps/web/.env.example` is the development version and explains what every
# variable is for. This one is the production shape.
#
# This file holds no database credential and must never be given one. It holds
# a mail credential, which is not the same thing: the website sends an
# enquiry's two messages so that a panel which is down cannot swallow one, and
# it still cannot read a row of the database.
#
# Several of these are read at BUILD time, not just at runtime — the pages are
# prerendered. Change one and the site has to be rebuilt, not just restarted.

# ---------------------------------------------------------------------------
# Content
# ---------------------------------------------------------------------------
# Where the panel is, FROM THIS BOX. Loopback, because both run here — it is
# an internal call on every build and every revalidation, and sending it out
# through the public hostname and back is a round trip through the tunnel for
# no reason.
CONTENT_API_URL="http://127.0.0.1:6011"

CONTENT_SOURCE="api"

# The backstop for a revalidation that never arrived, not the mechanism. Do
# not shorten it to paper over a push that is not getting through; fix the
# push.
CONTENT_REVALIDATE_SECONDS=3600

# Must equal SITE_REVALIDATE_SECRET in apps/admin/.env.
REVALIDATE_SECRET="GENERATE-ME"

# Must equal PREVIEW_SECRET in apps/admin/.env.
PREVIEW_SECRET="GENERATE-ME"

# ---------------------------------------------------------------------------
# Media
# ---------------------------------------------------------------------------
# The same value as MEDIA_PUBLIC_URL in apps/admin/.env.
#
# The panel builds every image URL from its own copy, so this one does not
# decide where photographs load from. What it decides is which hosts an <img>
# inside a journal entry's prose is allowed to point at (src/lib/rich-text.ts):
# wrong, and those figures are dropped from the page — silently, because a
# refused image is the safe reading of an untrusted src.
MEDIA_PUBLIC_URL="https://s3.example.com/lotuspeak-media"

# ---------------------------------------------------------------------------
# This site
# ---------------------------------------------------------------------------
# The public origin, absolute, no trailing slash. Canonicals, the sitemap, the
# feed, the Open Graph URLs and every JSON-LD @id are built from it at build
# time. Wrong here means a site that works perfectly and tells every crawler
# it lives somewhere else.
NEXT_PUBLIC_SITE_URL="https://lotuspeak.org"

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# Unset RESEND_API_KEY means enquiries are recorded and their messages
# rendered and reported, but nothing is sent. That is the right default
# everywhere except here.
RESEND_API_KEY="re_YOUR_KEY"

# The domain must be verified in Resend or every send is refused. That DKIM
# signature is the whole reason this goes through a provider instead of SMTP
# from the VM, whose IP has no sending reputation and would land in spam.
MAIL_FROM="Lotus Peak <info@lotuspeak.org>"

# Where a traveller's reply goes when the company record has no address.
MAIL_REPLY_TO="info@lotuspeak.org"

# Where the office copy of an enquiry goes. Comma-separated. Unset means
# nobody is written to — the one setting worth checking after a deploy.
MAIL_OFFICE_TO="info@lotuspeak.org"

# Must equal MAIL_REPORT_SECRET in apps/admin/.env.
MAIL_REPORT_SECRET="GENERATE-ME"
