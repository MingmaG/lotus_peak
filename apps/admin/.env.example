# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The admin panel owns this. The website has no credential for it and must
# never be given one — it reads /api/public/site/* instead.
DATABASE_URL="postgresql://lotuspeak:lotuspeak@localhost:6012/lotuspeak?schema=public"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# `bash scripts/generate-secrets.sh` from the repo root prints all three.
# Two secrets, not one: an access token leaked from a log is worth fifteen
# minutes, and rotating it must not sign everybody out.
AUTH_SECRET="change-me"
AUTH_REFRESH_SECRET="change-me-too"
AUTH_ACCESS_TTL_MINUTES=15
AUTH_REFRESH_TTL_DAYS=30

# ---------------------------------------------------------------------------
# The website
# ---------------------------------------------------------------------------
# Where to push a revalidation when something is published, and where the
# "View on site" and preview links point.
SITE_URL="http://localhost:6010"
# Must equal REVALIDATE_SECRET in apps/web/.env. They are the two ends of one
# HMAC; different values mean publishing silently stops reaching the site
# until the hourly refresh picks it up.
SITE_REVALIDATE_SECRET="change-me-as-well"
# Signs a preview link, so a draft is visible to whoever clicked Preview and
# to nobody else.
PREVIEW_SECRET="change-me-again"

# ---------------------------------------------------------------------------
# Media storage
# ---------------------------------------------------------------------------
# `local` writes to ./storage and serves through /api/storage — fine for a
# single box. `s3` is MinIO in development and Supabase or any S3 in
# production; the driver is identical, which is the point of running MinIO.
STORAGE_DRIVER="s3"
# Where the `local` driver writes. Relative to apps/admin.
STORAGE_LOCAL_DIR="storage"
S3_ENDPOINT="http://localhost:6013"
S3_REGION="us-east-1"
S3_BUCKET="lotuspeak-media"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_FORCE_PATH_STYLE=true
# The origin the website is handed in image URLs. Public, and read by
# next.config's remotePatterns in both apps.
MEDIA_PUBLIC_URL="http://localhost:6013/lotuspeak-media"
# Only read by the `local` driver, which serves media through /api/storage on
# this app and so has to tell the website what to resolve those paths against.
# With `s3` the URLs are already absolute and this is never consulted — so a
# wrong value here is invisible until the day somebody switches the driver, and
# then every photograph on the site has a localhost src.
ADMIN_PUBLIC_URL="http://localhost:6011"

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# There is no API key here, and that is on purpose. The *website* renders and
# sends an enquiry's two messages — see apps/web/.env.example — so that a panel
# which is down, restarting or mid-deploy cannot stop an enquiry reaching the
# office. What stays on this side is what only this side can do: keep the
# record, count the day's allowance, and take the provider's delivery notices.
#
# Shared with the website, which uses it to report what it sent. Must equal
# MAIL_REPORT_SECRET in apps/web/.env. Unset means the endpoint is off, not
# open — it writes the office's record of what a traveller received. The cost
# of leaving it unset is mail that goes out and an Email screen that stays
# empty, which /api/health and Settings both say.
MAIL_REPORT_SECRET="change-me-as-well"
# Signs Resend's delivery notices, from the webhook's page in the dashboard —
# it begins `whsec_`. Point the webhook at
# https://<this app>/api/webhooks/resend and subscribe it to email.delivered,
# email.bounced, email.complained, email.opened and email.delivery_delayed.
# Unset means the endpoint is off, not open: without it every message stops at
# "sent", which only means Resend accepted it, and a bounce is never recorded.
RESEND_WEBHOOK_SECRET=""
# How many messages a day may be handed to the provider. Resend's free plan
# allows a hundred. The count lives in this database, so the website asks for
# what is left when it records an enquiry and obeys the answer; over the line a
# message is recorded as skipped against the enquiry it belongs to, so the
# office can see who went unanswered. A website that cannot reach this panel
# sends anyway — at that moment the mail is the only thing carrying the enquiry.
MAIL_DAILY_CAP=100
