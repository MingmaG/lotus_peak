# ---------------------------------------------------------------------------
# Content
# ---------------------------------------------------------------------------
# Where the admin panel's public API is. This site has no database credential
# and reads everything through it — which is also why the admin panel has to
# be running when this site builds: generateStaticParams asks it for the
# journey and journal slugs.
CONTENT_API_URL="http://localhost:6011"

# `api` reads the admin panel. `file` reads src/content/data and needs nothing
# running — the fixture, and the proof no page is coupled to a provider.
CONTENT_SOURCE="api"

# The backstop for a revalidation push that never arrived — a restart
# mid-publish, a network blip. Not the publishing mechanism: the admin panel
# pushes an invalidation the moment anything is published, and an hour of
# staleness is a far better failure than a thundering herd every minute.
CONTENT_REVALIDATE_SECONDS=3600

# Must equal SITE_REVALIDATE_SECRET in apps/admin/.env. They are the two ends
# of one HMAC; different values mean publishing silently stops reaching this
# site until the hourly refresh picks it up.
REVALIDATE_SECRET="change-me"

# Signs a preview link, so a draft is visible to whoever clicked Preview in
# the admin panel and to nobody else. Must equal PREVIEW_SECRET there.
PREVIEW_SECRET="change-me-too"

# ---------------------------------------------------------------------------
# Media
# ---------------------------------------------------------------------------
# Where the photographs are served from. The same value as MEDIA_PUBLIC_URL in
# apps/admin/.env — read by next.config's remotePatterns, without which every
# photograph on the site is a 500 whose message names the hostname rather than
# the config.
MEDIA_PUBLIC_URL="http://localhost:6013/lotuspeak-media"

# ---------------------------------------------------------------------------
# This site
# ---------------------------------------------------------------------------
# Absolute, no trailing slash. Canonicals, the sitemap and the JSON-LD @ids
# are built from it, and an @id that changes between renders is not an
# identifier.
NEXT_PUBLIC_SITE_URL="http://localhost:6010"

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# This site sends an enquiry's two messages itself — the office's notification
# and the traveller's acknowledgement — rather than leaving them to the admin
# panel. That is deliberate: a panel which is down, restarting or mid-deploy
# would otherwise take the office's copy down with it, and an enquiry nobody
# is told about is the one failure this site cannot have. The words come from
# the panel like any other content and are cached here for the hour; the record
# of what was sent goes back to it afterwards, best-effort.
#
# Unset means an enquiry's messages are rendered and reported but not sent.
# That is the correct development default: a fixture full of test addresses
# must not be able to email anybody, and the wording can still be read on the
# panel's Email screen before a key is ever set.
RESEND_API_KEY=""
# The verified sending identity. The domain must be verified in Resend, or
# every send is refused — DKIM for the domain is the whole reason this goes
# through a provider rather than SMTP from the box, whose IP has no sending
# reputation and would land in spam.
MAIL_FROM="Lotus Peak <info@lotuspeak.org>"
# Where a traveller's reply goes when the company record has no address on it.
# The office's copy ignores this and replies to the traveller instead, which is
# what makes Reply work on a notification.
MAIL_REPLY_TO="info@lotuspeak.org"
# Where the office copy of an enquiry goes. Comma-separated. Unset means
# nobody in the office is written to, which is logged loudly and is the one
# setting here worth checking after a deploy.
MAIL_OFFICE_TO="info@lotuspeak.org"
# Lets this site write what it sent to the panel's Email screen. Must equal
# MAIL_REPORT_SECRET in apps/admin/.env. Unset means mail still goes out and
# none of it is recorded — the panel says so on Settings and /api/health.
MAIL_REPORT_SECRET="change-me-as-well"
