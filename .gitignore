node_modules/
.next/
out/
build/
dist/
.env
.env.local
.env*.local
.DS_Store
*.tsbuildinfo
next-env.d.ts
.turbo/
storage/
apps/web/public/assets/**/PLACEHOLDER

# The WordPress export from lotuspeak.org. The text is kept as the provenance
# for the imported content; the 24 MB of media is not — every photograph that
# is actually used now lives in apps/web/public/assets/imagery, and the rest
# was theme furniture (shape*.webp, backgrounds, logos).
/content-import/wordpress/images/
/content-import/wordpress/content/**/*.html

# Browser snapshots from Playwright MCP — scratch output of a debugging
# session, not a fixture. Regenerated every run.
.playwright-mcp/

# PM2 writes the two apps' stdout and stderr here (deploy/ecosystem.config.js).
deploy/logs/

# The media library on its way between two S3 stores (deploy/media-sync.mjs).
# A full copy of every photograph: it belongs in a bucket, not in git.
deploy/media-export/

# The real environment files PM2 loads on the server. They hold the JWT secrets,
# the database URL and the Resend key; only the .example beside each is tracked.
deploy/env/*.env

# A pg_dump on its way to the server (deploy/README.md). The whole database,
# password hashes and enquiries included.
*.dump
